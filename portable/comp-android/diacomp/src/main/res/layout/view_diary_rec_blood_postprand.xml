<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/padding_tiny"
    android:background="@drawable/background_diary_blood_postprand"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/padding_small">

    <TextView
        android:id="@+id/textBloodTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_tiny"
        android:text="08:45"
        android:textColor="@color/diary_font"
        android:textSize="@dimen/diaryTextSizeBase"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/textBloodValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_small"
        android:layout_weight="1.0"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="5.0 mmol/l (R1)"
        android:textColor="@color/diary_font"
        android:textSize="@dimen/diaryTextSizeBase"
        tools:ignore="HardcodedText" />

</LinearLayout>