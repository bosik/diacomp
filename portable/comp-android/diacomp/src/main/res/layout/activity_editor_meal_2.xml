<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gravity="bottom|fill"
    android:orientation="vertical"
    android:padding="@dimen/padding_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="vertical"
        android:visibility="visible"
        tools:context=".ActivityEditorMeal">

        <TextView
            android:id="@+id/labelMealTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_common_field_time"
            android:textAllCaps="false" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dip"
            android:background="#c0c0c0"
            android:divider="?android:dividerHorizontal" />

        <LinearLayout
            android:id="@+id/layoutMealDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/padding_small">

            <Button
                android:id="@+id/buttonMealDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:text="@string/editor_common_stub_date"
                android:textSize="@dimen/font_datetime" />

            <Button
                android:id="@+id/buttonMealTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/editor_common_stub_time"
                android:textSize="@dimen/font_datetime" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelMealCalculation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_meal_header_dosage" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dip"
            android:background="#c0c0c0"
            android:divider="?android:dividerHorizontal" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/padding_small">

            <TableRow
                android:id="@+id/mealRowActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingRight="@dimen/padding_small"
                    android:text="@string/editor_meal_label_insulin_dosage"
                    tools:text="96 г" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/padding_medium"
                    android:paddingRight="@dimen/padding_medium"
                    android:text="+"
                    tools:ignore="RtlSymmetry" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 ед" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/padding_medium"
                    android:paddingRight="@dimen/padding_medium"
                    android:text="=" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.8 ммоль/л"
                    android:textAllCaps="false"
                    android:textStyle="normal|bold" />
            </TableRow>

            <TableRow
                android:id="@+id/mealRowCarbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="85 г"
                        android:textColor="@color/font_gray" />

                    <TextView
                        android:id="@+id/textView16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingLeft="@dimen/padding_medium"
                        android:text="[-11]"
                        android:textAllCaps="false"
                        android:textColor="@color/meal_correction_negative"
                        android:textStyle="normal|bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/padding_medium"
                    android:paddingRight="@dimen/padding_medium"
                    android:text="+"
                    android:textColor="@color/font_gray"
                    tools:ignore="RtlSymmetry" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 ед"
                    android:textColor="@color/font_gray" />

                <TextView
                    android:id="@+id/textView13"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/padding_medium"
                    android:paddingRight="@dimen/padding_medium"
                    android:text="="
                    android:textColor="@color/font_gray" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5.0 ммоль/л"
                    android:textColor="@color/font_gray" />

            </TableRow>

            <TableRow
                android:id="@+id/mealRowBS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingRight="@dimen/padding_small"
                    android:text="@string/editor_meal_label_insulin_dosage"
                    android:textColor="@color/font_gray"
                    tools:text="96 г" />

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/padding_medium"
                    android:paddingRight="@dimen/padding_medium"
                    android:text="+"
                    android:textColor="@color/font_gray"
                    tools:ignore="RtlSymmetry" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView17"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="16.7 ед"
                        android:textColor="@color/font_gray" />

                    <TextView
                        android:id="@+id/textView10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingLeft="@dimen/padding_medium"
                        android:text="[+1.7]"
                        android:textColor="@color/font_gray"
                        android:textStyle="normal|bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/padding_medium"
                    android:paddingRight="@dimen/padding_medium"
                    android:text="="
                    android:textColor="@color/font_gray" />

                <TextView
                    android:id="@+id/textView12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5.0 ммоль/л"
                    android:textColor="@color/font_gray" />

            </TableRow>
        </TableLayout>

        <TextView
            android:id="@+id/labelMealContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_meal_header_content" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dip"
            android:background="#c0c0c0"
            android:divider="?android:dividerHorizontal" />
    </LinearLayout>

    <org.bosik.diacomp.android.frontend.views.fdpicker.MealEditorView
        android:id="@+id/mealEditorMeal"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>